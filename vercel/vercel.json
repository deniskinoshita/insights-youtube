{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "functions": {
    "api/analisar.js": {
      "maxDuration": 300
    },
    "api/checar.js": {
      "maxDuration": 300
    }
  }
}
